    "steps": {
      "joinGroup": {
        "title": "Join a Group",
        "description": "Start by joining a betting group using an invite code from your friends or create your own group.",
        "step1": "Go to the Groups page from the sidebar menu",
        "step2": "Click the \"Join Group\" button at the top",
        "step3": "Enter the invite code shared by your group admin",
        "step4": "Once joined, you'll see the group in your list with members count and default balance"
      },
      "placeBet": {
        "title": "Place a Bet",
        "description": "Browse upcoming World Cup matches and place your predictions with virtual currency.",
        "step1": "Navigate to the Match Center from the sidebar",
        "step2": "Find an upcoming match with a \"Bet Now\" button",
        "step3": "Click \"Bet Now\" to open the betting dialog",
        "step4": "Select which team you think will win (considering the handicap)",
        "step5": "Enter your bet amount within the allowed range",
        "step6": "Confirm your bet before the betting window closes"
      },
      "viewBets": {
        "title": "View Match Bets",
        "description": "After a match starts or finishes, see how other members in your group have bet.",
        "step1": "On a Live or Finished match card, click the \"View\" button",
        "step2": "See all group members' bets with their avatars and chosen teams",
        "step3": "The winning team column is highlighted after settlement",
        "step4": "Track who won and who lost in each match"
      },
      "myBets": {
        "title": "My Bets",
        "description": "Track all your betting history — see your pending, won, and lost bets in one place.",
